FROM maven:3.9.6-eclipse-temurin-25 AS build
WORKDIR /app
COPY . .
# Compila específicamente el módulo feriados
RUN mvn clean package -DskipTests -pl feriados -am

FROM eclipse-temurin:25-jre-alpine
WORKDIR /app
COPY --from=build /app/feriados/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]