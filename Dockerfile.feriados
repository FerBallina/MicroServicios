FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY . .

# Compila y reempaqueta el módulo de forma limpia
RUN mvn clean package -pl feriados -am -DskipTests

RUN echo "--- CONTENIDO DEL JAR ---" && jar tf /app/feriados/target/feriados-0.0.1-SNAPSHOT.jar

FROM eclipse-temurin:21-jre
WORKDIR /app

# Copiamos el Fat JAR corregido con su estructura interna correcta
COPY --from=build /app/feriados/target/feriados-0.0.1-SNAPSHOT.jar feriados-api.jar

EXPOSE 8082

# Comando nativo estándar
ENTRYPOINT ["java", "-jar", "feriados-api.jar"]