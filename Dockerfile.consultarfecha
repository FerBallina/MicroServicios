# Paso 1: Construir el JAR usando el proyecto padre
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY . .
# Compila solo el microservicio 'consultarfecha' y sus dependencias necesarias
RUN mvn clean package -DskipTests -pl consultarfecha -am

RUN echo "--- CONTENIDO DEL JAR ---" && jar tf /app/consultarfecha/target/consultarfecha-0.0.1-SNAPSHOT.jar


# Paso 2: Ejecutar la aplicación
FROM eclipse-temurin:21-jre
WORKDIR /app
# Copia el JAR generado dentro de la carpeta del microservicio
COPY --from=build /app/consultarfecha/target/consultarfecha-0.0.1-SNAPSHOT.jar consultarfecha-api.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "consultarfecha-api.jar"]