FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY . .

# Compila y reempaqueta el módulo de forma limpia
RUN mvn clean package -pl consultarfecha -am -DskipTests

RUN echo "--- CONTENIDO DEL JAR ---" && jar tf /app/consultarfecha/target/consultarfecha-0.0.1-SNAPSHOT.jar

FROM eclipse-temurin:21-jre
WORKDIR /app

# Copiamos el Fat JAR corregido que ahora contiene todo adentro
COPY --from=build /app/consultarfecha/target/consultarfecha-0.0.1-SNAPSHOT.jar consultarfecha-api.jar

EXPOSE 8081

# Comando nativo estándar: Spring Boot sabe exactamente cómo leer el contenido de BOOT-INF
ENTRYPOINT ["java", "-jar", "consultarfecha-api.jar"]