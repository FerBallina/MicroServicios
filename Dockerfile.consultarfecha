FROM maven:3.9-eclipse-temurin-25 AS builder
WORKDIR /app
COPY . .
# Compila específicamente el módulo consultarfecha
RUN mvn clean package -DskipTests -pl consultarfecha -am

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /app/consultarfecha/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]