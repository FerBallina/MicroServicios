FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY . .
# Compila específicamente el módulo feriados
RUN mvn clean package -pl feriados -am -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/feriados/target/feriados-0.0.1-SNAPSHOT.jar feriados-api.jar
EXPOSE 8080
ENTRYPOINT ["java", "-cp", "feriados-api.jar", "org.springframework.boot.loader.launch.JarLauncher"]