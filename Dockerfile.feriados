FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY . .
# Compila específicamente el módulo feriados
RUN mvn clean package -DskipTests -f "/app/feriados/pom.xml"

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/feriados/target/*.jar feriados-api.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "feriados-api.jar"]